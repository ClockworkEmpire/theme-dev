{
  "name": "Business Card",
  "description": "Displays a business listing with logo, name, and details",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show Badges",
      "default": true,
      "info": "Display featured and verified badges"
    },
    {
      "type": "range",
      "id": "services_limit",
      "label": "Max Services Shown",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "Description Word Limit",
      "default": 25,
      "min": 10,
      "max": 50,
      "step": 5
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "View Details"
    }
  ]
}
