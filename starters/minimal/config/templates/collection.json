{
  "name": "Collection",
  "description": "Displays a list of dataset records with pagination",
  "settings": [
    {
      "type": "range",
      "id": "items_per_page",
      "label": "Items Per Page",
      "default": 12,
      "min": 6,
      "max": 24,
      "step": 6
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid Layout",
      "default": "grid-3",
      "options": [
        { "value": "grid-2", "label": "2 Columns" },
        { "value": "grid-3", "label": "3 Columns" },
        { "value": "grid-4", "label": "4 Columns" },
        { "value": "list", "label": "List View" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Pagination",
      "default": true
    }
  ]
}
